# Files of migration 0001, in the order they run. "admin" files run as the administrator; the rest run as ry_owner.
# Changing a file after it was applied is detected by `apply.sh verify` (the checksum covers every file listed here).
admin  security/database_roles.sql
admin  schema/database-config.sql
owner  schema/database-schema.sql
owner  migrations/migration_history.sql
owner  users/users.sql
owner  users/user_profiles.sql
owner  users/user_preferences.sql
owner  users/user_sessions.sql
owner  users/user_activity.sql
owner  financial/financial_records.sql
owner  financial/transactions.sql
owner  financial/loan_records.sql
owner  financial/investment_records.sql
owner  financial/savings_records.sql
owner  financial/financial_reports.sql
owner  calculators/calculator_history.sql
owner  calculators/emi_history.sql
owner  calculators/sip_history.sql
owner  calculators/fd_history.sql
owner  calculators/tax_history.sql
owner  calculators/calculation_metadata.sql
owner  ai/chat_sessions.sql
owner  ai/chat_messages.sql
owner  ai/chat_feedback.sql
owner  ai/engine_execution_history.sql
owner  ai/ai_execution_logs.sql
owner  schema/database-constraints.sql
owner  security/audit_logs.sql
owner  security/row_level_security.sql
owner  security/retention_policies.sql
owner  schema/database-indexes.sql
